# Database URL dari Neon Postgres (Connection string dengan sslmode=require)
DATABASE_URL="postgresql://neondb_owner:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
# Di Vercel, NEXTAUTH_URL otomatis terdeteksi atau isi dengan domain Vercel Anda (e.g. https://papan-rapat.vercel.app)
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="buat-secret-acak-yang-panjang-misal-openssl-rand-base64-32"
